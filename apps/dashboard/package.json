{
	"name": "@diffkit/dashboard",
	"private": true,
	"type": "module",
	"imports": {
		"#/*": "./src/*"
	},
	"scripts": {
		"predev": "node ../../scripts/link-worktree-dev-vars.mjs",
		"dev": "vite dev --port 3000 --strictPort",
		"build": "NODE_OPTIONS='--max-old-space-size=4096' vite build",
		"preview": "vite preview",
		"test": "vitest run",
		"format": "biome format",
		"lint": "biome lint",
		"check": "biome check",
		"check-types": "tsc --noEmit",
		"migrate": "pnpm run migrate:local",
		"migrate:local": "node --experimental-strip-types ../../scripts/run-d1-migrations.mjs DB --local",
		"migrate:remote": "node --experimental-strip-types ../../scripts/run-d1-migrations.mjs DB --remote",
		"deploy": "pnpm run build && wrangler deploy",
		"deploy:ci": "pnpm run build && wrangler deploy"
	},
	"dependencies": {
		"@cloudflare/vite-plugin": "^1.67.0",
		"@diffkit/icons": "workspace:*",
		"@diffkit/ui": "workspace:*",
		"@noble/ciphers": "^2.1.1",
		"@noble/hashes": "^2.0.1",
		"@number-flow/react": "^0.6.0",
		"@pierre/diffs": "^1.1.12",
		"@pierre/trees": "1.0.0-beta.6",
		"@tailwindcss/vite": "^4.3.5",
		"@tanstack/react-devtools": "~0.10.2",
		"@tanstack/react-query": "~5.107.1",
		"@tanstack/react-query-persist-client": "~5.107.1",
		"@tanstack/react-router": "~1.170.46",
		"@tanstack/react-router-devtools": "~1.167.3",
		"@tanstack/react-router-ssr-query": "~1.167.3",
		"@tanstack/react-start": "~1.169.5",
		"@tanstack/react-virtual": "^3.13.24",
		"@tanstack/router-plugin": "~1.169.0",
		"@xyflow/react": "^12.10.2",
		"agentation": "^3.0.2",
		"better-auth": "^1.6.0",
		"drizzle-orm": "^0.45.2",
		"fflate": "^0.8.2",
		"idb-keyval": "^6.3.0",
		"motion": "^12.38.0",
		"next-themes": "^0.4.6",
		"nuqs": "^2.8.9",
		"octokit": "^5.0.5",
		"react": "^19.2.0",
		"react-dom": "^19.2.0",
		"react-dropzone": "^15.0.0",
		"recharts": "^3.8.1",
		"skullet": "0.0.3",
		"tailwindcss": "^4.3.5",
		"yaml": "^2.8.3"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.5",
		"@cloudflare/workers-types": "^5.20261109.1",
		"@diffkit/typescript-config": "workspace:*",
		"@tanstack/devtools-vite": "~0.8.6",
		"@testing-library/dom": "^10.4.1",
		"@testing-library/react": "^16.3.0",
		"@types/node": "^22.10.2",
		"@types/react": "^19.2.0",
		"@types/react-dom": "^19.2.0",
		"@vitejs/plugin-react": "^6.2.1",
		"drizzle-kit": "^0.31.10",
		"fake-indexeddb": "^6.2.7",
		"jsdom": "^28.1.0",
		"react-scan": "^0.5.3",
		"typescript": "^5.7.2",
		"vite": "^8.3.6",
		"vite-tsconfig-paths": "^6.1.1",
		"vitest": "^4.1.12",
		"wrangler": "^4.158.0"
	}
}
